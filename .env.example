BOT_TOKEN=
STREAM_ROOT=/streams
API_PORT=3000
INTERNAL_TOKEN=change-me
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
MUSIC_WORKER_URL=http://music-worker:8080
# PostgreSQL (required): tracked messages, the audit log, playlists and other data the bot keeps adding to.
# The workspace compose sets these for its postgres service. DATABASE_PORT defaults to 5432.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
# Or one URL instead (it wins when set) — for a managed database, or options such as sslmode.
DATABASE_URL=
PIPIT_API_URL=http://localhost:3000
# where people open the dashboard: sign-in callbacks and the music channel remote's link
DASHBOARD_URL=
# signs the session cookie; required in production
DASHBOARD_SESSION_SECRET=
DASHBOARD_ADMIN_GROUPS=pipit-admins
# the first admin, created once when no password account exists
DASHBOARD_BOOTSTRAP_USERNAME=
DASHBOARD_BOOTSTRAP_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# the button on the sign-in page; default: SSO
OIDC_DISPLAY_NAME=
# Discord and GitHub sign-in (OAuth apps of their own, not the bot token or the GitHub App)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
