BOT_TOKEN=
STREAM_ROOT=/streams
API_PORT=3000
INTERNAL_TOKEN=change-me
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
MUSIC_WORKER_URL=http://music-worker:8080
# PostgreSQL (required): tracked messages, the audit log, playlists and other data the bot keeps adding to.
# The workspace compose sets these for its postgres service. DATABASE_PORT defaults to 5432.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
# Or one URL instead (it wins when set) — for a managed database, or options such as sslmode.
DATABASE_URL=
PIPIT_API_URL=http://localhost:3000
DASHBOARD_ADMIN_GROUPS=pipit-admins
DASHBOARD_DEV_USER=dev
DASHBOARD_DEV_ROLE=admin
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
DASHBOARD_SESSION_SECRET=
# the dashboard's address for the music channel remote's link; default: the origin of OIDC_REDIRECT_URI
DASHBOARD_URL=
